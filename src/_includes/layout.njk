<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ site.description }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:image" content="{{ '/assets/images/big-walk-logo.png' | url }}">
<link rel="icon" href="{{ '/assets/images/big-walk-logo.png' | url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Deseret&family=Noto+Sans:wght@400;600;700&display=swap">
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
<script>
  window.SITE_CONFIG = {
    repo: {{ site.repo | dump | safe }},
    branch: {{ site.branch | dump | safe }},
    endpoint: {{ site.suggestions.endpoint | dump | safe }},
    maxUploadMB: {{ site.suggestions.maxUploadMB | dump | safe }},
    discordUrl: {{ site.discordUrl | dump | safe }}
  };
  (function () {
    var stored = localStorage.getItem("theme");
    if (stored) document.documentElement.dataset.theme = stored;
    document.addEventListener("DOMContentLoaded", function () {
      var width = localStorage.getItem("width") === "full" ? "full" : "boxed";
      var button = document.getElementById("width-toggle");
      /* chevrons-right-left shrinks back to the column, chevrons-left-right opens it up. */
      var svg = function (paths) {
        return '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"' +
          ' stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + paths + '</svg>';
      };
      var OUT = svg('<path d="m9 7-5 5 5 5"/><path d="m15 7 5 5-5 5"/>');
      var IN = svg('<path d="m20 17-5-5 5-5"/><path d="m4 17 5-5-5-5"/>');
      function apply() {
        document.body.dataset.width = width;
        button.innerHTML = width === "full" ? IN : OUT;
        button.title = width === "full" ? "Half width" : "Full width";
        button.setAttribute("aria-label", button.title);
      }
      apply();
      button.addEventListener("click", function () {
        width = width === "full" ? "boxed" : "full";
        localStorage.setItem("width", width);
        apply();
      });
    });
  })();
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap">
    <img class="logo" src="{{ '/assets/images/big-walk-logo.png' | url }}" alt="Big Walk logo">
    <div class="titles">
      <h1>{{ site.title }}</h1>
      <p class="updated">Updated {{ site.updated }}</p>
    </div>
    <nav class="header-links">
      <a href="{{ site.discordUrl }}">Discord</a>
      <a href="{{ site.speedrunUrl }}">Leaderboards</a>
      <button type="button" class="icon-btn" data-suggest-open data-kind="addition" title="Suggest a change" aria-label="Suggest a change">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
      </button>
      <button type="button" class="icon-btn" id="auth-btn" hidden></button>
      <button type="button" class="icon-btn" id="suggestions-toggle" aria-pressed="false"></button>
      <button type="button" class="icon-btn" id="width-toggle"></button>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch theme" title="Switch theme"></button>
    </nav>
  </div>
</header>

<div class="layout">
  <aside class="toc" aria-label="Table of contents">
    <nav id="toc-nav"></nav>
  </aside>
  <main id="main">
    {{ content | safe }}
  </main>
</div>

<footer class="site-footer">
  <div class="wrap">
    <p>Select any text and right-click to suggest a change.</p>
    <p><a href="https://github.com/{{ site.repo }}">Source</a></p>
    <p><a href="https://github.dev/{{ site.repo }}">Edit on GitHub</a></p>
  </div>
</footer>

<script src="{{ '/assets/js/theme.js' | url }}" defer></script>
<script src="{{ '/assets/js/scrollbar.js' | url }}" defer></script>
<script src="{{ '/assets/js/embeds.js' | url }}" defer></script>
<script src="{{ '/assets/js/toc.js' | url }}" defer></script>
<script src="{{ '/assets/js/suggest.js' | url }}" defer></script>
<script src="{{ '/assets/js/comments.js' | url }}" defer></script>
</body>
</html>
