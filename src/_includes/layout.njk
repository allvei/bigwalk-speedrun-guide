<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ site.description }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:image" content="{{ '/assets/images/big-walk-logo.png' | url }}">
<link rel="icon" href="{{ '/assets/images/big-walk-logo.png' | url }}">
<!-- Whatever the browser's default font is, text painted before the stylesheets arrive should
     already be the site's own sans. -->
<style>html{font-family:"Noto Sans Deseret","Noto Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}</style>
<link rel="preload" as="style" href="{{ '/assets/css/style.css' | url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Deseret&family=Noto+Sans:wght@400;600;700&display=swap">
<script>
  window.SITE_CONFIG = {
    repo: {{ site.repo | dump | safe }},
    branch: {{ site.branch | dump | safe }},
    endpoint: {{ site.suggestions.endpoint | dump | safe }},
    maxUploadMB: {{ site.suggestions.maxUploadMB | dump | safe }},
    discordUrl: {{ site.discordUrl | dump | safe }}
  };
  /* Theme and width are settled before the first paint; applied later the page would visibly
     jump from the default to the stored setting. */
  (function () {
    var stored = localStorage.getItem("theme");
    if (stored) document.documentElement.dataset.theme = stored;
    var width = localStorage.getItem("width") === "full" ? "full" : "boxed";
    document.documentElement.dataset.width = width;
    document.addEventListener("DOMContentLoaded", function () {
      var button = document.getElementById("width-toggle");
      function apply() {
        document.documentElement.dataset.width = width;
        button.title = width === "full" ? "Half width" : "Full width";
        button.setAttribute("aria-label", button.title);
      }
      apply();
      button.addEventListener("click", function () {
        width = width === "full" ? "boxed" : "full";
        localStorage.setItem("width", width);
        apply();
      });
    });
  })();
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap">
    <img class="logo" src="{{ '/assets/images/big-walk-logo.png' | url }}" alt="Big Walk logo">
    <div class="titles">
      <h1>{{ site.title }}</h1>
      <p class="updated">Updated {{ site.updated }}</p>
    </div>
    <nav class="header-links">
      <a href="{{ site.discordUrl }}">Discord</a>
      <a href="{{ site.speedrunUrl }}">Leaderboards</a>
      <button type="button" class="icon-btn" data-suggest-open data-kind="addition" title="Suggest a change" aria-label="Suggest a change">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
      </button>
      <button type="button" class="icon-btn" id="auth-btn" title="Sign in with GitHub" aria-label="Sign in with GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
      </button>
      <button type="button" class="icon-btn" id="suggestions-toggle" aria-pressed="false" title="Show suggestions" aria-label="Show suggestions">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </button>
      <button type="button" class="icon-btn" id="width-toggle">
        <svg class="width-out" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 7-5 5 5 5"/><path d="m15 7 5 5-5 5"/></svg>
        <svg class="width-in" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 17-5-5 5-5"/><path d="m4 17 5-5-5-5"/></svg>
      </button>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch theme" title="Switch theme">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      </button>
    </nav>
  </div>
</header>

<div class="layout">
  <aside class="toc" aria-label="Table of contents">
    <nav id="toc-nav"></nav>
  </aside>
  <main id="main">
    {{ content | safe }}
  </main>
</div>

<footer class="site-footer">
  <div class="wrap">
    <p>Select any text and right-click to suggest a change.</p>
    <p><a href="https://github.com/{{ site.repo }}">Source</a></p>
    <p><a href="https://github.dev/{{ site.repo }}">Edit on GitHub</a></p>
  </div>
</footer>

<script src="{{ '/assets/js/theme.js' | url }}" defer></script>
<script src="{{ '/assets/js/scrollbar.js' | url }}" defer></script>
<script src="{{ '/assets/js/embeds.js' | url }}" defer></script>
<script src="{{ '/assets/js/toc.js' | url }}" defer></script>
<script src="{{ '/assets/js/suggest.js' | url }}" defer></script>
<script src="{{ '/assets/js/comments.js' | url }}" defer></script>
</body>
</html>
