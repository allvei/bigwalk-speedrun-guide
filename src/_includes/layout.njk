<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ site.description }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:image" content="{{ '/assets/images/big-walk-logo.png' | url }}">
<link rel="icon" href="{{ '/assets/images/big-walk-logo.png' | url }}">
<!-- Whatever the browser's default font is, text painted before the stylesheets arrive should
     already be the site's own sans. -->
<style>html{font-family:"Noto Sans Deseret","Noto Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}</style>
<link rel="preload" as="style" href="{{ '/assets/css/style.css' | url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Deseret&family=Noto+Sans:wght@400;600;700&display=swap">
<script>
  window.SITE_CONFIG = {
    repo: {{ site.repo | dump | safe }},
    branch: {{ site.branch | dump | safe }},
    endpoint: {{ site.suggestions.endpoint | dump | safe }},
    maxUploadMB: {{ site.suggestions.maxUploadMB | dump | safe }},
    discordUrl: {{ site.discordUrl | dump | safe }}
  };
  /* Theme and width are settled before the first paint; applied later the page would visibly
     jump from the default to the stored setting. */
  (function () {
    var stored = localStorage.getItem("theme");
    if (stored) document.documentElement.dataset.theme = stored;
    var width = localStorage.getItem("width") === "full" ? "full" : "boxed";
    document.documentElement.dataset.width = width;
    document.addEventListener("DOMContentLoaded", function () {
      var button = document.getElementById("width-toggle");
      function apply() {
        document.documentElement.dataset.width = width;
        button.title = width === "full" ? "Half width" : "Full width";
        button.setAttribute("aria-label", button.title);
      }
      apply();
      button.addEventListener("click", function () {
        width = width === "full" ? "boxed" : "full";
        localStorage.setItem("width", width);
        apply();
      });
    });
  })();
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap">
    <img class="logo logo-light-mode" src="{{ '/assets/images/Big_Walk-logo-dark-alpha.png' | url }}" alt="Big Walk logo">
    <img class="logo logo-dark-mode" src="{{ '/assets/images/Big_Walk-logo-light-alpha.png' | url }}" alt="Big Walk logo">
    <button type="button" class="icon-btn toc-toggle" id="toc-toggle" aria-expanded="false" title="Contents" aria-label="Contents">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
    </button>
    <div class="titles">
      <h1>{{ site.title }}</h1>
    </div>
    <button type="button" class="icon-btn nav-toggle" id="nav-toggle" aria-expanded="false" title="Menu" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
    </button>
    <nav class="header-links">
      <p class="drawer-title">Menu</p>
      <a class="icon-btn" href="{{ site.discordUrl }}" title="Discord" aria-label="Discord">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 4.9A19.8 19.8 0 0 0 15.4 3.4l-.2.4c1.6.4 3 1 4.4 1.9a16.6 16.6 0 0 0-15.2 0c1.3-.9 2.8-1.5 4.4-1.9l-.2-.4A19.8 19.8 0 0 0 3.7 4.9C.9 9 .2 13 .6 17a19.9 19.9 0 0 0 6 3c.4-.6.8-1.2 1.1-1.9a13 13 0 0 1-1.8-.9l.4-.3a14.2 14.2 0 0 0 12.2 0l.5.3c-.6.4-1.2.7-1.9.9.3.7.7 1.3 1.1 1.9a19.8 19.8 0 0 0 6-3c.6-4.7-.7-8.6-3.9-12.1ZM8.3 14.6c-1.2 0-2.1-1.1-2.1-2.4 0-1.3.9-2.4 2.1-2.4s2.2 1.1 2.2 2.4c0 1.3-1 2.4-2.2 2.4Zm7.4 0c-1.2 0-2.1-1.1-2.1-2.4 0-1.3.9-2.4 2.1-2.4s2.2 1.1 2.2 2.4c0 1.3-1 2.4-2.2 2.4Z"/></svg>
        <span class="btn-label">Discord</span>
      </a>
      <a class="icon-btn" href="{{ site.speedrunUrl }}" title="Leaderboards" aria-label="Leaderboards">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        <span class="btn-label">Leaderboards</span>
      </a>
      <a class="icon-btn" href="https://github.com/{{ site.repo }}" title="Source on GitHub" aria-label="Source on GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.6.8.5A11.5 11.5 0 0 0 12 .5Z"/></svg>
        <span class="btn-label">Source</span>
      </a>
      <span class="header-sep" aria-hidden="true"></span>
      <button type="button" class="icon-btn" data-suggest-open data-kind="addition" title="Suggest a change" aria-label="Suggest a change">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
        <span class="btn-label">Suggest a change</span>
      </button>
      <button type="button" class="icon-btn" id="suggestions-list" title="All suggestions" aria-label="All suggestions">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/><path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"/></svg>
        <span class="btn-label">Suggestions</span>
      </button>
      <button type="button" class="icon-btn" id="suggestions-toggle" aria-pressed="false" title="Show suggestions" aria-label="Show suggestions">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </button>
      <span class="header-sep" aria-hidden="true"></span>
      <button type="button" class="icon-btn" id="width-toggle">
        <svg class="width-out" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 7-5 5 5 5"/><path d="m15 7 5 5-5 5"/></svg>
        <svg class="width-in" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 17-5-5 5-5"/><path d="m4 17 5-5-5-5"/></svg>
        <span class="btn-label">Page width</span>
      </button>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch theme" title="Switch theme">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <span class="btn-label">Switch theme</span>
      </button>
      <span class="header-sep" aria-hidden="true"></span>
      <button type="button" class="icon-btn" id="auth-btn" title="Sign in with GitHub" aria-label="Sign in with GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
        <span class="btn-label">Sign in</span>
      </button>
    </nav>
  </div>
</header>

<div class="drawer-backdrop" id="drawer-backdrop" hidden></div>

<div class="layout">
  <aside class="toc" aria-label="Table of contents">
    <p class="drawer-title">Contents</p>
    <nav id="toc-nav"></nav>
  </aside>
  <main id="main">
    <p class="page-updated">Updated {{ site.updated }}</p>
    {{ content | safe }}
  </main>
</div>

<script src="{{ '/assets/js/nav.js' | url }}" defer></script>
<script src="{{ '/assets/js/tooltips.js' | url }}" defer></script>
<script src="{{ '/assets/js/theme.js' | url }}" defer></script>
<script src="{{ '/assets/js/scrollbar.js' | url }}" defer></script>
<script src="{{ '/assets/js/embeds.js' | url }}" defer></script>
<script src="{{ '/assets/js/images.js' | url }}" defer></script>
<script src="{{ '/assets/js/lists.js' | url }}" defer></script>
<script src="{{ '/assets/js/toc.js' | url }}" defer></script>
<script src="{{ '/assets/js/suggest.js' | url }}" defer></script>
<script src="{{ '/assets/js/comments.js' | url }}" defer></script>
</body>
</html>
